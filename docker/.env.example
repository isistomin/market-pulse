# Copy to docker/.env and fill in. Never commit the result.
#
#   cp docker/.env.example docker/.env
#   echo "AIRFLOW_UID=$(id -u)" >> docker/.env
#   python -c "import secrets; print('FERNET_KEY=' + secrets.token_urlsafe(32))" >> docker/.env
#   python -c "import secrets; print('AIRFLOW_JWT_SECRET=' + secrets.token_urlsafe(32))" >> docker/.env
#   python -c "import secrets; print('AIRFLOW_ADMIN_PASSWORD=' + secrets.token_urlsafe(24))" >> docker/.env

# Host user id. Required on Linux: without it, files created in the mounted
# directories are owned by root and cannot be edited from the host.
AIRFLOW_UID=

# Encrypts Connections and Variables in the metadata database. Rotating the key
# makes already stored values unreadable.
FERNET_KEY=

# Signs JWTs between the API server and the other Airflow services.
AIRFLOW_JWT_SECRET=

# The Airflow UI is not published beyond loopback, but these still have to be
# generated rather than left at a default: anything with shell access to the host
# can reach the port.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# Comma-separated origins allowed to call the dashboard API.
# Local development: http://localhost:5173
# Deployed: https://market-pulse.example.com
API_CORS_ORIGINS=http://localhost:5173
